{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "browser-provisioner": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "styles": ["src/style.css"],
            "outputPath": {
              "base": "../dist/frontend",
              "browser": ""
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "browser-provisioner:build:production"
            },
            "development": {
              "buildTarget": "browser-provisioner:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 5173
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "3a02fb74-b1cf-43a8-901d-7c8cd03fa603",
    "cache": {
      "enabled": false
    }
  }
}
