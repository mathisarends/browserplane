{
  "name": "browserplane",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "generated",
    "generated-backend"
  ],
  "scripts": {
    "predev": "npm run generate",
    "dev": "vite --config vite.config.ts",
    "build": "npm run check:clients && tsc --noEmit && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "npm run generate:rpc && npm run generate:api && npm run generate:python",
    "generate:rpc": "uv run --locked fastapi-rpckit generate --config ../rpcgen.toml",
    "generate:api": "uv run --locked python ../scripts/export_openapi_schemas.py && lit-canon-api generate",
    "generate:python": "uv run --locked python ../scripts/generate_http_clients.py",
    "check:generated": "npm run check:rpc && npm run check:api && npm run check:python",
    "check:rpc": "uv run --locked fastapi-rpckit generate --config ../rpcgen.toml --check",
    "check:api": "uv run --locked python ../scripts/export_openapi_schemas.py && lit-canon-api check",
    "check:python": "uv run --locked python ../scripts/generate_http_clients.py --check",
    "check:clients": "npm run check --workspaces --if-present",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@browsertunnel/backend-client": "0.1.0",
    "@browsertunnel/browser-rpc-client": "0.1.0",
    "lit": "3.3.3",
    "@lit/context": "1.1.6",
    "@lit-labs/router": "0.1.4",
    "@lit-labs/signals": "0.3.0",
    "@tanstack/lit-query": "0.2.25",
    "urlpattern-polyfill": "10.1.0",
    "lit-canon-fetch": "file:../vendor/lit-canon-fetch-1.0.0-4fe0827.tgz",
    "lit-canon-composition": "file:../vendor/lit-canon-composition-0.1.0-4fe0827.tgz"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "lit-canon-api": "file:../vendor/lit-canon-api-1.0.0-4fe0827.tgz",
    "vite": "7.3.7",
    "@playwright/test": "1.64.1"
  },
  "overrides": {
    "undici": "7.30.1",
    "fast-uri": "3.1.9",
    "source-map-js": "1.2.2"
  }
}
